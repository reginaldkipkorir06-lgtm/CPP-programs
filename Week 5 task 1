#include <iostream>
using namespace std;

int main() {
    double revenue[7];
    double total = 0;

    for (int i = 0; i < 7; i++) {
        cout << "Enter revenue for day " << i + 1 << ": ";
        cin >> revenue[i];

        total += revenue[i];
    }

    cout << "Total Weekly Revenue: " << total << endl;
    cout << "Average Daily Revenue: " << total / 7 << endl;

    return 0;
}
